# Add the PVE features not selected by the Raspberry Pi configuration.
# The builder derives CONFIG_LOCALVERSION from RPI_FLAVOUR.
-e CONFIG_IPV6
-e CONFIG_KSM
-e CONFIG_TRANSPARENT_HUGEPAGE
-e CONFIG_TRANSPARENT_HUGEPAGE_MADVISE
-d CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS
-e CONFIG_HUGETLBFS
-e CONFIG_KVM
-m CONFIG_TARGET_CORE
-m CONFIG_VDPA
-m CONFIG_VHOST_SCSI
-m CONFIG_VHOST_VDPA
-e CONFIG_SECCOMP
-e CONFIG_SECCOMP_FILTER
-e CONFIG_CGROUPS
-e CONFIG_MEMCG
-e CONFIG_MEMCG_V1
-e CONFIG_CPUSETS
-e CONFIG_CGROUP_HUGETLB
-e CONFIG_CGROUP_MISC
-e CONFIG_CGROUP_RDMA
-e CONFIG_CGROUP_DMEM
-e CONFIG_NAMESPACES
-e CONFIG_USER_NS
-e CONFIG_PID_NS
-e CONFIG_NET_NS
-m CONFIG_VETH
-m CONFIG_VLAN_8021Q
-m CONFIG_OVERLAY_FS
-e CONFIG_OVERLAY_FS_XINO_AUTO
-e CONFIG_SECURITY
-e CONFIG_SECURITY_NETWORK
-e CONFIG_SECURITY_APPARMOR
--set-str CONFIG_LSM lockdown,yama,integrity,apparmor
-e CONFIG_SECURITY_LOCKDOWN_LSM
-e CONFIG_SECURITY_LOCKDOWN_LSM_EARLY
-e CONFIG_SECURITY_YAMA
-e CONFIG_SECURITY_LANDLOCK
-e CONFIG_SECURITY_SAFESETID
-e CONFIG_SECURITY_DMESG_RESTRICT
-e CONFIG_IMA
-e CONFIG_EVM
-e CONFIG_MODVERSIONS
-e CONFIG_NETFILTER
-e CONFIG_BRIDGE
-e CONFIG_PREEMPT_DYNAMIC
-e CONFIG_BRIDGE_NETFILTER
-e CONFIG_TUN
-e CONFIG_NETWORK_SECMARK
-e CONFIG_VIRTIO
-e CONFIG_VIRTIO_BLK
-e CONFIG_VIRTIO_NET
-e CONFIG_VIRTIO_CONSOLE
-e CONFIG_VIRTIO_PCI
-e CONFIG_VIRTIO_MMIO
-m CONFIG_VIRTIO_FS
-m CONFIG_VIRTIO_VSOCKETS
-m CONFIG_NETFILTER_XTABLES
-e CONFIG_NETFILTER_XTABLES_LEGACY
-m CONFIG_IP_NF_IPTABLES
-m CONFIG_IP_NF_IPTABLES_LEGACY
-m CONFIG_IP_NF_RAW
-m CONFIG_IP6_NF_IPTABLES_LEGACY
