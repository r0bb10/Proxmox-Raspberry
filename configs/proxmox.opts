-m CONFIG_NETFILTER_NETLINK_HOOK
-e CONFIG_BLK_DEV_DM
-m CONFIG_BLK_DEV_UBLK
-e CONFIG_FUSE_FS
-e CONFIG_SQUASHFS
-e CONFIG_CEPH_FSCACHE
-e CONFIG_CEPH_FS_POSIX_ACL
-e CONFIG_CEPH_FS_SECURITY_LABEL
