# Add the PVE features not selected by the Raspberry Pi configuration.
--set-str CONFIG_LOCALVERSION ""
-e CONFIG_IPV6
-e CONFIG_KSM
-e CONFIG_KVM
-e CONFIG_SECCOMP
-e CONFIG_SECCOMP_FILTER
-e CONFIG_CGROUPS
-e CONFIG_MEMCG
-e CONFIG_CPUSETS
-e CONFIG_NAMESPACES
-e CONFIG_USER_NS
-e CONFIG_PID_NS
-e CONFIG_NET_NS
-m CONFIG_VETH
-m CONFIG_VLAN_8021Q
-m CONFIG_OVERLAY_FS
-e CONFIG_SECURITY
-e CONFIG_SECURITY_APPARMOR
-e CONFIG_NETWORK_SECMARK
-e CONFIG_VIRTIO
-e CONFIG_VIRTIO_PCI
-e CONFIG_VIRTIO_MMIO
-m CONFIG_NETFILTER_XTABLES
-m CONFIG_IP_NF_IPTABLES
-m CONFIG_IP6_NF_IPTABLES
-m CONFIG_NFT_COMPAT
