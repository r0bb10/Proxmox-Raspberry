+	sed -e 's/@@KVNAME@@/$(KVNAME)/g' < debian/proxmox-kernel.rpi-initramfs-hook.in > debian/$(PMX_KERNEL_PKG)/etc/initramfs/post-update.d/z50-proxmox-kernel-$(subst .,_,$(KVNAME))
+	chmod 0755 debian/$(PMX_KERNEL_PKG)/etc/initramfs/post-update.d/z50-proxmox-kernel-$(subst .,_,$(KVNAME))
+	install -m 644 $(KERNEL_SRC)/.config debian/$(PMX_KERNEL_PKG)/boot/config-$(KVNAME)
