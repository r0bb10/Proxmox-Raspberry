+	install -m 644 $(KERNEL_SRC)/arch/arm64/boot/dts/broadcom/@BOOT_DTB@ debian/$(PMX_KERNEL_PKG)/usr/lib/proxmox-kernel/$(KVNAME)/@BOOT_DTB@
diff --git a/debian/proxmox-kernel.rpi-initramfs-hook.in b/debian/proxmox-kernel.rpi-initramfs-hook.in
new file mode 100644
--- /dev/null
+++ b/debian/proxmox-kernel.rpi-initramfs-hook.in
@@ -0,0 +1,17 @@
+#!/bin/sh
+set -eu
+
+version=@@KVNAME@@
+
+[ "${1:-}" = "$version" ] || exit 0
+
+initrd=${2:?missing initramfs path}
+firmware_dir=/boot/firmware
+
+if ! mountpoint -q "$firmware_dir"; then
+	printf 'proxmox-kernel: %s is not mounted\n' "$firmware_dir" >&2
+	exit 1
+fi
+
+install -m 0644 "$initrd" "$firmware_dir/@BOOT_INITRAMFS@"
+sync -f "$firmware_dir"
