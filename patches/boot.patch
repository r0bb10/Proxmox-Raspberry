diff --git a/debian/proxmox-kernel.postinst.in b/debian/proxmox-kernel.postinst.in
index bde7e59..d3d3d8d 100755
--- a/debian/proxmox-kernel.postinst.in
+++ b/debian/proxmox-kernel.postinst.in
@@ -18 +18,25 @@
-if (-d "/etc/kernel/postinst.d") {
+my $kernel_dir = "/usr/lib/proxmox-kernel/$version";
+my $image = "$kernel_dir/Image.gz";
+my $dtb = "$kernel_dir/@BOOT_DTB@";
+my $firmware_dir = "/boot/firmware";
+
+# Raspberry Pi firmware loads fixed names from its FAT boot partition. Keep
+# package payloads versioned on the root filesystem and copy only the active
+# kernel, initramfs, and board DTB into /boot/firmware.
+if (-e "$firmware_dir/config.txt") {
+    die "Missing gzip-compressed ARM64 Image for $version\n" unless -s $image;
+    die "Missing Raspberry Pi DTB for $version\n" unless -s $dtb;
+    my $staging_dir = "/var/lib/proxmox-kernel/$version";
+    my $initrd = "$staging_dir/initrd.img-$version";
+    system("install", "-d", "-m", "0755", $staging_dir)
+        && die "Failed to create initramfs staging directory\n";
+    unlink $initrd;
+    system("update-initramfs", "-c", "-k", $version, "-b", $staging_dir)
+        && die "Failed to create initramfs for $version\n";
+    die "Missing generated initramfs for $version\n" unless -s $initrd;
+
+    system("install", "-m", "0644", $image, "$firmware_dir/@BOOT_KERNEL@")
+        && die "Failed to deploy Raspberry Pi kernel\n";
+    system("install", "-m", "0644", $dtb, "$firmware_dir/@BOOT_DTB@")
+        && die "Failed to deploy Raspberry Pi DTB\n";
+} elsif (-d "/etc/kernel/postinst.d") {
